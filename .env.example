# Copy to backend/.env for local development. Never commit the real file.

# Postgres connection string (Neon in production, local Postgres in dev)
DATABASE_URL=postgresql://pathwise:pathwise@localhost:5432/pathwise

# Flask session/signing secret. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me

# JWT signing secret. Must differ from SECRET_KEY. Same generator.
JWT_SECRET=replace-me-too

# Comma-separated allowed browser origins for CORS.
CORS_ORIGINS=https://pathwise.lol,https://www.pathwise.lol,http://localhost:8081

# Optional: password-reset email delivery. Unset means reset links are logged, not sent.
RESEND_API_KEY=
RESEND_FROM=PathWise <noreply@pathwise.lol>

# Public base URL used to build password-reset links.
APP_BASE_URL=https://pathwise.lol
